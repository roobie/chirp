{:openssl {:prefix "/opt/chirp-openssl"
           :configure ["no-shared" "no-tests" "no-docs" "no-apps" "no-module"
                       "no-afalgeng" "--libdir=lib" "--openssldir=/etc/ssl"]
           :make ["build_libs"]
           :install ["install_dev"]
           :libs ["libssl.a" "libcrypto.a"]}
 :exe {:name "chirp"
       :entry "src/chirp/main.janet"}
 # The build machine only builds the tooling that writes the image (janet,
 # OpenSSL and the natives it loads) with the container's compiler. Nothing
 # built here ships; its natives are shared objects, hence -fPIC.
 :build-machine {:openssl-flags ["-fPIC"]}
 # One entry per shipped target, picked by CHIRP_TARGET. Every one is built by
 # the pinned zig, so the compiler is the same whatever the target.
 # :janet-defines go to janet.c only, :defines to the natives only, and
 # :pin-cflags to the natives built from that pin.
 :targets {:linux-x64 {:triple "x86_64-linux-musl"
                       :openssl-target "linux-x86_64"
                       :cflags ["-std=c99" "-O2" "-fvisibility=hidden"]
                       # musl has posix_spawn_file_actions_addchdir_np but no
                       # macro for os.c to detect it by, so os/spawn's :cd is
                       # off unless asked for.
                       :janet-defines {"JANET_SPAWN_CHDIR" true}
                       # Static and without a build-id, which varies per build.
                       :lflags ["-static" "-s" "-Wl,--build-id=none"]
                       :libs ["-lm" "-lpthread" "-ldl"]}
           :linux-arm64 {:triple "aarch64-linux-musl"
                         :openssl-target "linux-aarch64"
                         :cflags ["-std=c99" "-O2" "-fvisibility=hidden"]
                         :janet-defines {"JANET_SPAWN_CHDIR" true}
                         :lflags ["-static" "-s" "-Wl,--build-id=none"]
                         :libs ["-lm" "-lpthread" "-ldl"]}
           # libSystem is the only dynamic dependency; macOS has no static libc.
           # The minimum OS version is pinned so it does not follow zig's default.
           :macos-arm64 {:triple "aarch64-macos.11.0"
                         :openssl-target "darwin64-arm64-cc"
                         :cflags ["-std=c99" "-O2" "-fvisibility=hidden"]
                         # The Apple random source needs CommonCrypto headers, which
                         # only an SDK has; OpenSSL then seeds from the OS instead.
                         :openssl-flags ["-DOPENSSL_NO_APPLE_CRYPTO_RANDOM"]
                         :lflags ["-s"]
                         :libs ["-lm" "-lpthread" "-ldl"]}
           :windows-x64 {:triple "x86_64-windows-gnu"
                         :openssl-target "mingw64"
                         :exe-suffix ".exe"
                         :cflags ["-std=c99" "-O2"]
                         # jsec compat.h defines clock_gettime for windows, which
                         # mingw's time.h also does (pthread_time.h) once jsec
                         # asks for POSIX features; skip the mingw one.
                         :defines {"WIN_PTHREADS_TIME_H" true}
                         # jsec declares its error buffers __declspec(thread),
                         # which clang honours only with MS extensions on;
                         # without them the buffers are shared by all threads.
                         :pin-cflags {:jsec ["-fms-extensions"]}
                         :format :pe
                         :lflags ["-s"]
                         :libs ["-lws2_32" "-lwsock32" "-lmswsock" "-lpsapi"
                                "-lcrypt32" "-luser32" "-ladvapi32"]}
           # The site's try page runs this; it is not a release file. A WASI
           # module whose host is src/wasm/wasi.mjs; Janet's error handling
           # needs wasm exception handling (D-HA7ATG3IF6P73TOI). No OpenSSL,
           # so no jsec; :skip-natives and the core functions this janet
           # compiles out are stubbed under their names (:stub-missing) so the
           # image built on the host loads unchanged (D-T6TVFVI3SEQKWL7F).
           :wasm32-wasi {:triple "wasm32-wasi"
                         :openssl false
                         :cflags ["-std=gnu99" "-O2" "-mllvm" "-wasm-enable-sjlj" "-mexception-handling"
                                  "-D_DEFAULT_SOURCE" "-D_WASI_EMULATED_SIGNAL"
                                  "-D_WASI_EMULATED_PROCESS_CLOCKS" "-D_WASI_EMULATED_MMAN"
                                  # Janet's feature switches change what janet.h
                                  # declares, so janet.c, the natives and the
                                  # image's main all need them, not just janet.c.
                                  "-DJANET_NO_EV" "-DJANET_NO_NET" "-DJANET_NO_THREADS"
                                  "-DJANET_SINGLE_THREADED" "-DJANET_NO_PROCESSES"
                                  "-DJANET_NO_DYNAMIC_MODULES" "-DJANET_NO_FFI" "-DJANET_NO_FFI_JIT"
                                  "-DJANET_NO_FILEWATCH" "-DJANET_NO_SYMLINKS" "-DJANET_NO_UMASK"
                                  "-DJANET_NO_REALPATH" "-DJANET_NO_INTERPRETER_INTERRUPT"]
                         :repo-includes ["src/wasm/include"]
                         :force-includes ["src/wasm/compat.h"]
                         :skip-natives ["spork/rawterm"]
                         :stub-missing true
                         :repo-sources ["src/wasm/setjmp.c" "src/wasm/libc.c"]
                         :exe-suffix ".wasm"
                         :lflags ["-Wl,--strip-all" "-Wl,--gc-sections" "-Wl,-z,stack-size=1048576"]
                         :libs ["-lwasi-emulated-signal" "-lwasi-emulated-process-clocks"
                                "-lwasi-emulated-mman"]}}
 # Pinned checkouts whose root holds importable Janet modules.
 :janet-sources [:spork :jsec :spork-https]
 # Single modules the :all: templates cannot find: a pinned checkout whose entry
 # file is not named after it, or a module chirp owns, at :file in this repo
 # (:pin :repo). Relative imports resolve from :file.
 :janet-modules [{:name "tomlin" :pin :tomlin :file "init.janet"}
                 {:name "tar" :pin :repo :file "src/tar/tar.janet"}]}
