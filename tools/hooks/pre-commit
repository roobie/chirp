#!/bin/sh
# Tracked hooks; enable once per clone: git config core.hooksPath tools/hooks
top="$(git rev-parse --show-toplevel)"

# leakcheck is plain Janet, so chirp runs it too where janet is not installed.
runner=$(command -v janet || command -v chirp) || { echo "leakcheck: neither janet nor chirp found; refusing an unchecked commit" >&2; exit 1; }
"$runner" "$top/tools/leakcheck/leakcheck.janet" staged || exit 1

# dev-proc needs chirp's bundled yaml and sqlite3, which plain janet lacks.
command -v chirp >/dev/null 2>&1 || { echo "dev-proc: chirp not found, skipping checks" >&2; exit 0; }
# Warnings alone let a commit with refs broken by a file move through; set
# DEV_PROC_STRICT=0 for a one-off commit that must go in anyway.
DEV_PROC_STRICT=${DEV_PROC_STRICT-1} exec chirp "$top/.claude/skills/dev-proc/scripts/dev-proc.janet" check --staged --hook
