{# A -dev suffix marks builds from main; release.yml requires the tag to equal
 # this, so a release first drops the suffix.
 :version "0.4.0-dev"
 # `chirp self-update` reads <base>/latest/download/ and <base>/download/v<version>/,
 # a file tree that any mirror can serve.
 :update {:base "https://github.com/roobie/chirp/releases"
          # Janet's (os/which) -> (os/arch) -> release target name.
          :targets {:linux {:x64 "linux-x64" :aarch64 "linux-arm64"}
                    :macos {:aarch64 "macos-arm64"}
                    :windows {:x64 "windows-x64"}}}
 # First existing file becomes the TLS trust store unless SSL_CERT_FILE is set.
 :ca-paths ["/etc/ssl/certs/ca-certificates.crt"
            "/etc/pki/tls/certs/ca-bundle.crt"
            "/etc/ssl/cert.pem"]
 # Help topics whose text lives outside help/, stem -> path from this directory.
 # The changelog is a repo-root file people read on GitHub; copying it into
 # help/ would let the two drift.
 :help-extra {"changelog" "../../CHANGELOG.md"}
 # Bundled module -> chirp module whose public bindings replace the module's own.
 :overlays {"spork-https" "./overlay-spork-https"
            "spork/json" "./overlay-spork-json"}
 # Modules resolvable with nothing on disk. spork/tasker is left out: its peg
 # schema is stringified with a heap address at compile time, so the image
 # differs per run.
 :modules ["spork/argparse" "spork/base64" "spork/channel" "spork/cmath"
           "spork/crc" "spork/cron" "spork/data" "spork/date" "spork/ev-utils"
           "spork/fmt" "spork/generators" "spork/getline" "spork/htmlgen"
           "spork/http" "spork/httpf" "spork/infix" "spork/json" "spork/math"
           "spork/misc" "spork/msg" "spork/netrepl" "spork/path" "spork/randgen"
           "spork/rawterm" "spork/regex" "spork/rpc" "spork/schema" "spork/sh"
           "spork/sh-dsl" "spork/stream" "spork/tarray"
           "spork/temple" "spork/test" "spork/utf8" "spork/zip"
           "jsec/utils" "jsec/tls-stream" "jsec/dtls-stream" "jsec/tls"
           "jsec/cert" "jsec/bio" "jsec/crypto" "jsec/ca"
           "spork-https" "sqlite3" "tomlin" "yaml" "pcre2" "md4c" "lexbor" "omap" "json-omap"]}
