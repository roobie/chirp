{# A -dev suffix marks builds from main; release.yml requires the tag to equal
 # this, so a release first drops the suffix.
 :version "0.12.0-dev"
 # The project site; `chirp --version` names it so the binary leads to its docs.
 :homepage "https://roobie.github.io/chirp/"
 # `chirp --self-update` reads <base>/latest/download/ and <base>/download/v<version>/,
 # a file tree that any mirror can serve.
 :update {:base "https://github.com/roobie/chirp/releases"
          # The release public key, a file in src/chirp/.
          :key "release-key.pem"
          # `--channel NAME` reads a tree of its own and trusts only the key named
          # here, never the release key.
          :channels {:main {:base "https://roobie.github.io/chirp/latest"
                            :key "main-build-key.pem"}}
          # Janet's (os/which) -> (os/arch) -> release target name.
          :targets {:linux {:x64 "linux-x64" :aarch64 "linux-arm64"}
                    :macos {:aarch64 "macos-arm64"}
                    :windows {:x64 "windows-x64"}}}
 # Unless SSL_CERT_FILE is set, the first existing file becomes the TLS trust
 # store, keyed by (os/which) with :default for the rest. macOS and windows keep
 # trust in stores of their own, which chirp exports instead (src/chirp/ca.janet):
 # macOS's /etc/ssl/cert.pem is a snapshot the OS does not keep current.
 :ca-paths {:default ["/etc/ssl/certs/ca-certificates.crt"
                      "/etc/pki/tls/certs/ca-bundle.crt"
                      "/etc/ssl/cert.pem"]
            :macos []
            :windows []
            :mingw []}
 # Help topics whose text lives outside help/, stem -> path from this directory.
 # The changelog is a repo-root file people read on GitHub; copying it into
 # help/ would let the two drift.
 :help-extra {"changelog" "../../CHANGELOG.md"}
 # The help topic indexed by goal: it must name every bundled module, and its
 # entries rank above others of the same relevance.
 :help-goals "tasks"
 # `chirp --help serve`: where it listens unless --host or --port say otherwise, and the
 # stylesheet its pages use (the project site's, so the two look alike).
 :help-serve {:host "127.0.0.1" :port 3111 :style "../../site/style.css"}
 # Where a binding's definition is read from while the image is built, to show it in
 # `chirp --help read --source`. A :source-map file starting with :prefix is found at
 # :dir plus the rest of its name, under the build's out dir (or the repo, :base :repo),
 # and shown as :show plus the rest: the display never holds a host path. Janet's
 # own boot.janet is the whole name, so its rule has no rest. A file no rule
 # matches simply has no source.
 :help-source [{:prefix "boot.janet" :dir "src/janet/src/boot/boot.janet"
                :show "janet/src/boot/boot.janet"}
               {:prefix "src/core/" :dir "src/janet/src/core/" :show "janet/src/core/"}
               {:prefix "src/spork/" :dir "src/spork/" :show "spork/"}
               {:prefix "src/spork-https/" :dir "src/spork-https/" :show "spork-https/"}
               {:prefix "src/zip.c" :dir "src/spork/src/zip.c" :show "spork/src/zip.c"}
               {:prefix "src/jsec/" :dir "src/jsec/" :show "jsec/"}
               {:prefix "src/tomlin/" :dir "src/tomlin/" :show "tomlin/"}
               # chirp-owned natives (md4c, pcre2, lexbor, omap, yaml) compile from the repo.
               {:prefix "./src/" :base :repo :dir "src/" :show "chirp/"}
               # The container mounts the repo at /chirp-src.
               {:prefix "/chirp-src/src/chirp/" :base :repo :dir "src/chirp/" :show "chirp/"}
               # chirp-owned Janet modules (tar), like the natives above.
               {:prefix "/chirp-src/src/" :base :repo :dir "src/" :show "chirp/"}]
 # Agent skills that `chirp --<name> --install` can write, name -> directory from
 # this directory. The repo's own copy stays the source of truth.
 :skills {"dev-proc" "../../.agents/skills/dev-proc"}
 # Files ending so are not shipped: the skill's own dev tests.
 :skill-exclude [".test.janet"]
 # Where the canonical copy goes, and the agent directories that link to it,
 # both relative to the install base.
 :skill-canonical ".agents/skills"
 :skill-links [".claude/skills"]
 # Bundled module -> chirp module whose public bindings replace the module's own
 # (behaviour or, for spork/tarray, only docs).
 :overlays {"spork-https" "./overlay-spork-https"
            "spork/json" "./overlay-spork-json"
            "spork/tarray" "./overlay-spork-tarray"}
 # Short names people try for a bundled module, besides its last path segment
 # (json for spork/json). Importing one that is not on disk fails with a hint.
 :import-aliases {"toml" "tomlin" "sqlite" "sqlite3" "https" "spork-https"
                  "markdown" "md4c" "pcre" "pcre2"}
 # Modules resolvable with nothing on disk. spork/tasker is left out: its peg
 # schema is stringified with a heap address at compile time, so the image
 # differs per run.
 :modules ["spork/argparse" "spork/base64" "spork/channel" "spork/cmath"
           "spork/crc" "spork/cron" "spork/data" "spork/date" "spork/ev-utils"
           "spork/fmt" "spork/generators" "spork/getline" "spork/htmlgen"
           "spork/http" "spork/httpf" "spork/infix" "spork/json" "spork/math"
           "spork/misc" "spork/msg" "spork/netrepl" "spork/path" "spork/randgen"
           "spork/rawterm" "spork/regex" "spork/rpc" "spork/schema" "spork/sh"
           "spork/sh-dsl" "spork/stream" "spork/tarray"
           "spork/temple" "spork/test" "spork/utf8" "spork/zip"
           "jsec/utils" "jsec/tls-stream" "jsec/dtls-stream" "jsec/tls"
           "jsec/cert" "jsec/bio" "jsec/crypto" "jsec/ca"
           "spork-https" "sqlite3" "tomlin" "yaml" "pcre2" "md4c" "lexbor" "omap" "json-omap"
           "gzip" "tar"]}
